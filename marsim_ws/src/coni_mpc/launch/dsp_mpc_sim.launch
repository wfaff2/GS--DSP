<launch>
  <!-- The numerical simulator owns /clock. Sensors, moving obstacles and DSP
       follow the same timeline, even when a control cycle takes longer in wall time. -->
  <arg name="sim_publish_clock" default="true" />
  <param name="/use_sim_time" value="$(arg sim_publish_clock)" />

  <!-- One-command integration launch. The DSP node still needs its normal
       depth-cloud and pose inputs (or a rosbag publishing them). -->
  <arg name="start_dsp" default="true" />
  <!-- Edit parameters/dsp_mpc_scene.yaml. Nonempty launch arguments override YAML. -->
  <arg name="scene_config" default="$(dirname)/../parameters/dsp_mpc_scene.yaml" />
  <arg name="scene" default="" />
  <arg name="v" default="" />
  <arg name="w" default="" />
  <arg name="trajectory_laps" default="" />
  <arg name="static_map_filename" default="" />
  <arg name="scene_resolver"
       default="python3 '$(dirname)/../scripts/resolve_dsp_scene.py' --config '$(arg scene_config)' --scene '$(arg scene)' --v '$(arg v)' --w '$(arg w)' --trajectory-laps '$(arg trajectory_laps)' --static-map '$(arg static_map_filename)'" />
  <arg name="num_uavs" default="" />
  <arg name="sim_duration_sec" default="" />
  <arg name="metrics_csv" default="" />
  <arg name="world_command_provenance_csv" default="" />
  <arg name="run_tag" default="" />
  <!-- Field-HOCBF acceptance target: run the controller at 50 Hz. -->
  <arg name="sim_control_dt_sec" default="0.02" />
  <arg name="cbf_enabled" default="true" />
  <arg name="cbf_use_in_sim" default="true" />
  <arg name="cbf_use_field_hocbf" default="true" />
  <arg name="field_replay_diagnostics" default="false" />
  <!-- Explicit baseline-controller selectors.  The previous MPC+CBF
       experiment used the non-inertial frame and a frozen UGV rollout. -->
  <arg name="frame_mode" default="noninertial" />
  <arg name="ugv_rollout_mode" default="" />
  <arg name="cbf_field_topic" default="/uav%d/my_map/future_occupancy_3d" />
  <arg name="world_frame_id" default="map" />
  <arg name="relative_frame_id" default="base_link" />
  <arg name="start_rviz" default="true" />
  <arg name="start_marsim_lidar" default="true" />
  <arg name="dsp_cluster_diagnostics" default="false" />
  <arg name="lidar_collision_enabled" default="true" />
  <arg name="lidar_collision_cloud_topic"
       default="/quad%d_pcl_render_node/cloud" />
  <arg name="lidar_collision_timeout_sec" default="0.5" />
  <!-- Exact world-point contact uses the UAV radius only.  Increase this
       explicitly only when compensating for a deliberately sparse cloud. -->
  <arg name="lidar_collision_point_margin" default="0.0" />

  <!-- Figure-eight uses the original formation defaults (UAV0: [-1,0,2]).
       Circle restores R_UGV=7 m and the inward UAV offset, giving R_UAV=5.5 m. -->
  <arg name="ugv_circle_radius" default="" />
  <arg name="uav_reference_offsets"
       default="" />

  <!-- MARSIM publishes the ground-truth map and internally generated dynamic
       obstacle clouds in "world", while CoNi-MPC and this RViz configuration
       use "map".  Their origins are identical in this standalone scene. -->
  <node pkg="tf2_ros" type="static_transform_publisher"
        name="dsp_mpc_map_to_world"
        args="0 0 0 0 0 0 map world" />

  <!-- Start the actual MARSIM map and Mid-360 renderer. This publishes
       /quad0_pcl_render_node/sensor_cloud and sensor_pose for DSP. -->
  <include if="$(arg start_marsim_lidar)"
           file="$(dirname)/marsim_depth_cbf_uav1.launch">
    <!-- Resolver selects the physical map and dynamic objects from the scene
         YAML. Regenerate the figure-eight PCD after changing its geometry. -->
    <arg name="scene_resolver" value="$(arg scene_resolver)" />
    <arg name="use_intensity_pcd_publisher" value="true" />
    <arg name="num_uavs" value="$(eval arg('num_uavs') or 3)" />
    <arg name="uav_odom_topic" value="/coni_mpc/quad_odom0" />
    <arg name="dynamic_obstacles" value="$(eval arg('scene') == 'circle')" />
    <arg name="dynamic_obstacle_count" value="$(eval 2 if arg('scene') == 'circle' else 0)" />
    <arg name="deterministic_box_mode" value="$(eval arg('scene') == 'circle')" />
    <arg name="box_config"
         value="$(dirname)/../parameters/dsp_mpc_single_obstacles.yaml" />
    <arg name="start_marsim" value="true" />
    <arg name="start_depth_cbf" value="false" />
    <arg name="start_rviz" value="false" />
    <arg name="sensor_pose_body_flu" value="true" />
  </include>

  <!-- UAV 0 DSP Mapping -->
  <node if="$(eval arg('start_dsp') and (arg('num_uavs') == '' or int(arg('num_uavs')) >= 1))"
        pkg="dynamic_occpuancy_map" type="map_sim_example"
        name="uav0_map_sim_example" output="screen">
    <param name="input_cloud_convention" value="body_flu" />
    <param name="full_360_lidar_fov" value="true" />
    <param name="cluster_diagnostics" value="$(arg dsp_cluster_diagnostics)" />
    <remap from="/camera_front/depth/points"
           to="/quad0_pcl_render_node/sensor_cloud" />
    <remap from="/mavros/local_position/pose"
           to="/quad0_pcl_render_node/sensor_pose" />
    <remap from="/my_map/future_occupancy_3d"
           to="/uav0/my_map/future_occupancy_3d" />
    <remap from="/my_map/future_status"
           to="/uav0/my_map/future_status" />
    <remap from="/my_map/cloud_ob"
           to="/uav0/my_map/cloud_ob" />
    <remap from="/my_map/map_center"
           to="/uav0/my_map/map_center" />
    <remap from="/my_map/predicted_ellipses"
           to="/uav0/my_map/predicted_ellipses" />
    <remap from="/my_map/predicted_ellipse_markers"
           to="/uav0/my_map/predicted_ellipse_markers" />
    <remap from="/my_map/velocity_marker"
           to="/uav0/my_map/velocity_marker" />
    <remap from="/my_map/single_object_velocity"
           to="/uav0/my_map/single_object_velocity" />
    <remap from="/my_map/single_object_velocity_ground_truth"
           to="/uav0/my_map/single_object_velocity_ground_truth" />
    <remap from="/visualization_marker"
           to="/uav0/visualization_marker" />
    <remap from="/visualization_fov"
           to="/uav0/visualization_fov" />
    <remap from="/map_update_time"
           to="/uav0/map_update_time" />
  </node>

  <!-- UAV 1 DSP Mapping -->
  <node if="$(eval arg('start_dsp') and (arg('num_uavs') == '' or int(arg('num_uavs')) >= 2))"
        pkg="dynamic_occpuancy_map" type="map_sim_example"
        name="uav1_map_sim_example" output="screen">
    <param name="input_cloud_convention" value="body_flu" />
    <param name="full_360_lidar_fov" value="true" />
    <param name="cluster_diagnostics" value="$(arg dsp_cluster_diagnostics)" />
    <remap from="/camera_front/depth/points"
           to="/quad1_pcl_render_node/sensor_cloud" />
    <remap from="/mavros/local_position/pose"
           to="/quad1_pcl_render_node/sensor_pose" />
    <remap from="/my_map/future_occupancy_3d"
           to="/uav1/my_map/future_occupancy_3d" />
    <remap from="/my_map/future_status"
           to="/uav1/my_map/future_status" />
    <remap from="/my_map/cloud_ob"
           to="/uav1/my_map/cloud_ob" />
    <remap from="/my_map/map_center"
           to="/uav1/my_map/map_center" />
    <remap from="/my_map/predicted_ellipses"
           to="/uav1/my_map/predicted_ellipses" />
    <remap from="/my_map/predicted_ellipse_markers"
           to="/uav1/my_map/predicted_ellipse_markers" />
    <remap from="/my_map/velocity_marker"
           to="/uav1/my_map/velocity_marker" />
    <remap from="/my_map/single_object_velocity"
           to="/uav1/my_map/single_object_velocity" />
    <remap from="/my_map/single_object_velocity_ground_truth"
           to="/uav1/my_map/single_object_velocity_ground_truth" />
    <remap from="/visualization_marker"
           to="/uav1/visualization_marker" />
    <remap from="/visualization_fov"
           to="/uav1/visualization_fov" />
    <remap from="/map_update_time"
           to="/uav1/map_update_time" />
  </node>

  <!-- UAV 2 DSP Mapping -->
  <node if="$(eval arg('start_dsp') and (arg('num_uavs') == '' or int(arg('num_uavs')) >= 3))"
        pkg="dynamic_occpuancy_map" type="map_sim_example"
        name="uav2_map_sim_example" output="screen">
    <param name="input_cloud_convention" value="body_flu" />
    <param name="full_360_lidar_fov" value="true" />
    <param name="cluster_diagnostics" value="$(arg dsp_cluster_diagnostics)" />
    <remap from="/camera_front/depth/points"
           to="/quad2_pcl_render_node/sensor_cloud" />
    <remap from="/mavros/local_position/pose"
           to="/quad2_pcl_render_node/sensor_pose" />
    <remap from="/my_map/future_occupancy_3d"
           to="/uav2/my_map/future_occupancy_3d" />
    <remap from="/my_map/future_status"
           to="/uav2/my_map/future_status" />
    <remap from="/my_map/cloud_ob"
           to="/uav2/my_map/cloud_ob" />
    <remap from="/my_map/map_center"
           to="/uav2/my_map/map_center" />
    <remap from="/my_map/predicted_ellipses"
           to="/uav2/my_map/predicted_ellipses" />
    <remap from="/my_map/predicted_ellipse_markers"
           to="/uav2/my_map/predicted_ellipse_markers" />
    <remap from="/my_map/velocity_marker"
           to="/uav2/my_map/velocity_marker" />
    <remap from="/my_map/single_object_velocity"
           to="/uav2/my_map/single_object_velocity" />
    <remap from="/my_map/single_object_velocity_ground_truth"
           to="/uav2/my_map/single_object_velocity_ground_truth" />
    <remap from="/visualization_marker"
           to="/uav2/visualization_marker" />
    <remap from="/visualization_fov"
           to="/uav2/visualization_fov" />
    <remap from="/map_update_time"
           to="/uav2/map_update_time" />
  </node>

  <!-- Legacy relay so tools listening to global /my_map/future_occupancy_3d still receive data -->
  <node if="$(arg start_dsp)"
        pkg="topic_tools" type="relay" name="dsp_future_occupancy_3d_legacy_relay"
        args="/uav0/my_map/future_occupancy_3d /my_map/future_occupancy_3d" />

  <node if="$(arg start_rviz)" pkg="rviz" type="rviz"
        name="dsp_mpc_rviz" output="screen"
        args="-d $(dirname)/../rviz/world.rviz" />

  <include file="$(dirname)/num_sim_non_one_point.launch">
    <arg name="scene_resolver" value="$(arg scene_resolver)" />
    <arg name="v" value="$(eval arg('v') or 1.0)" />
    <arg name="w" value="$(eval arg('w') or 0.135)" />
    <arg name="trajectory_laps" value="$(eval arg('trajectory_laps') or 2.0)" />
    <arg name="num_uavs" value="$(arg num_uavs)" />
    <arg name="world_frame_id" value="$(arg world_frame_id)" />
    <arg name="relative_frame_id" value="$(arg relative_frame_id)" />
    <arg name="cbf_enabled" value="$(arg cbf_enabled)" />
    <arg name="cbf_use_in_sim" value="$(arg cbf_use_in_sim)" />
    <arg name="cbf_use_field_hocbf" value="$(arg cbf_use_field_hocbf)" />
    <arg name="field_replay_diagnostics" value="$(arg field_replay_diagnostics)" />
    <arg name="frame_mode" value="$(arg frame_mode)" />
    <arg name="ugv_rollout_mode" value="$(arg ugv_rollout_mode)" />
    <arg name="cbf_field_topic" value="$(arg cbf_field_topic)" />
    <arg name="lidar_collision_enabled" value="$(arg lidar_collision_enabled)" />
    <arg name="lidar_collision_cloud_topic" value="$(arg lidar_collision_cloud_topic)" />
    <arg name="lidar_collision_timeout_sec" value="$(arg lidar_collision_timeout_sec)" />
    <arg name="lidar_collision_point_margin" value="$(arg lidar_collision_point_margin)" />
    <arg name="uav_reference_offsets" value="$(arg uav_reference_offsets)" />
    <arg name="ugv_circle_radius" value="$(arg ugv_circle_radius)" />
    <!-- The old benchmark creates analytic cylinders directly inside the
         simulator.  Disable them here: obstacles must enter through LiDAR
         and DSP only. -->
    <arg name="obstacle_count" value="0" />
    <arg name="figure_eight_obstacles_enabled" value="false" />
    <arg name="car_trajectory_mode" value="$(arg scene)" />
    <arg name="use_dynamic_obs" value="false" />
    <arg name="exclude_uav0_from_simulation" value="false" />
    <arg name="exclude_uav0_from_all_metrics" value="false" />
    <!-- dsp_mpc_rviz above is the only RViz instance for this launch. -->
    <arg name="use_rviz" value="false" />
    <!-- Pacing limits wall speed; it never changes the logical timestep.
         Warmup publishes initial odometry and advances the same /clock. -->
    <arg name="sim_publish_clock" value="$(arg sim_publish_clock)" />
    <arg name="sim_wait_for_field"
         value="$(eval arg('start_dsp') and arg('start_marsim_lidar') and arg('cbf_use_field_hocbf'))" />
    <arg name="sim_realtime_pacing" value="true" />
    <arg name="sim_startup_delay_sec" value="3.0" />
    <arg name="sim_control_dt_sec" value="$(arg sim_control_dt_sec)" />
    <arg name="sim_duration_sec" value="$(arg sim_duration_sec)" />
    <arg name="metrics_csv" value="$(arg metrics_csv)" />
    <arg name="world_command_provenance_csv" value="$(arg world_command_provenance_csv)" />
    <arg name="run_tag" value="$(arg run_tag)" />
  </include>
</launch>
